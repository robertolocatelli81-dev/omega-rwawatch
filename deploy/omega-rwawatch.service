[Unit]
Description=OMEGA-RWAWatch — one real-data snapshot + council + self-improve cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# %h = the user's home (systemd specifier): the unit assumes a checkout at ~/progetti/omega-rwawatch.
# PYTHONPATH is only needed if omega-evidence is used from a source tree rather than installed (pip install ".[evidence]").
ExecStart=/usr/bin/python3 %h/progetti/omega-rwawatch/rwawatch_orchestrator.py
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=%h/progetti/omega-evidence
WorkingDirectory=%h/progetti/omega-rwawatch
